{
  "name": "mealprep-planer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bls:extract": "tsx tools/bls-extract.ts",
    "bls:search": "tsx tools/bls-search.ts",
    "catalog": "tsx tools/build-catalog.ts",
    "catalog:check": "tsx tools/build-catalog.ts --check",
    "verify": "npm run typecheck && npm run lint && npm test && npm run catalog:check && npm run build",
    "catalog:report": "tsx tools/catalog-report.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxdb": "^17.5.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
