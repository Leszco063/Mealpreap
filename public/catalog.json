:2,"unit":"stk"},{"ingredientId":"avocado","amount":0.5,"unit":"stk"},{"ingredientId":"eier","amount":2,"unit":"stk"},{"ingredientId":"zitrone","amount":0.1,"unit":"stk","note":"ein Spritzer Saft"}],"steps":["Toast rösten.","Avocado mit einer Gabel zerdrücken, mit Zitronensaft, Salz und Pfeffer würzen.","Eier in einer beschichteten Pfanne als Spiegeleier braten.","Toast mit Avocado bestreichen, je ein Ei darauflegen und nach Wunsch mit Chiliflocken bestreuen."],"prepMinutes":5,"cookMinutes":5,"mealTypes":["breakfast"],"storage":{"kind":"fresh"},"tags":["schnell","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/avocado-toast-mit-ei"]},{"id":"bircher-muesli","title":"Bircher Müsli","description":"Eingeweichte Haferflocken mit geriebenem Apfel, Joghurt und Walnüssen nach Schweizer Art.","servings":2,"ingredients":[{"ingredientId":"haferflocken","amount":80,"unit":"g"},{"ingredientId":"milch-fettarm","amount":150,"unit":"ml"},{"ingredientId":"naturjoghurt","amount":250,"unit":"g"},{"ingredientId":"apfel","amount":2,"unit":"stk"},{"ingredientId":"zitrone","amount":0.5,"unit":"stk"},{"ingredientId":"walnuesse","amount":30,"unit":"g"},{"ingredientId":"honig","amount":15,"unit":"g"}],"steps":["Haferflocken mit der Milch verrühren und über Nacht im Kühlschrank quellen lassen.","Äpfel mit Schale grob reiben und sofort mit dem Saft der halben Zitrone mischen.","Apfel, Joghurt und Honig unter die Haferflocken rühren.","Auf zwei Gläser verteilen und mit gehackten Walnüssen bestreuen."],"prepMinutes":10,"cookMinutes":0,"mealTypes":["breakfast"],"storage":{"kind":"prep","fridgeDays":2,"freezable":false},"tags":["ohne-kochen","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/bircher-muesli","https://www.lecker.de/bircher-muesli-selber-machen-das-original-rezept-69869.html"]},{"id":"chia-pudding-beeren","title":"Chia-Pudding mit Beeren","description":"Chiasamen quellen über Nacht in Milch, dazu Skyr für extra Eiweiß und Heidelbeeren.","servings":1,"ingredients":[{"ingredientId":"chiasamen","amount":25,"unit":"g"},{"ingredientId":"milch-fettarm","amount":200,"unit":"ml"},{"ingredientId":"skyr","amount":100,"unit":"g"},{"ingredientId":"heidelbeeren-tk","amount":80,"unit":"g"}],"steps":["Chiasamen und Milch in einem Glas verrühren, nach 10 Minuten noch einmal umrühren, damit sich keine Klümpchen bilden.","Verschlossen mindestens 4 Stunden, besser über Nacht, kalt stellen.","Die Heidelbeeren im Kühlschrank auftauen lassen.","Pudding mit Skyr und Beeren schichten."],"prepMinutes":5,"cookMinutes":0,"mealTypes":["breakfast","snack"],"storage":{"kind":"prep","fridgeDays":2,"freezable":false},"tags":["ohne-kochen","vegetarisch"],"source":"starter","version":1,"sources":["https://www.lecker.de/chia-pudding-grundrezept-130918.html"]},{"id":"chili-con-carne","title":"Chili con Carne mit Reis","description":"Klassiker fürs Mealprep – hält 4 Tage im Kühlschrank und lässt sich gut einfrieren.","servings":4,"ingredients":[{"ingredientId":"rinderhack","amount":500,"unit":"g"},{"ingredientId":"zwiebel","amount":1,"unit":"stk"},{"ingredientId":"knoblauch","amount":2,"unit":"stk","note":"Zehen"},{"ingredientId":"paprika-rot","amount":2,"unit":"stk"},{"ingredientId":"tomaten-passiert","amount":500,"unit":"ml"},{"ingredientId":"kidneybohnen","amount":250,"unit":"g","note":"abgetropft"},{"ingredientId":"reis-parboiled","amount":250,"unit":"g"},{"ingredientId":"olivenoel","amount":1,"unit":"el"},{"ingredientId":"salz","amount":1,"unit":"tl"}],"steps":["Reis nach Packungsangabe garen.","Zwiebel und Knoblauch fein würfeln, Paprika in mundgerechte Stücke schneiden.","Öl in einem großen Topf erhitzen und das Hackfleisch darin krümelig anbraten.","Zwiebel, Knoblauch und Paprika zugeben und 3 Minuten mitbraten.","Passierte Tomaten und Bohnen einrühren, salzen, nach Geschmack mit Chili und Kreuzkümmel würzen und 20 Minuten köcheln lassen.","Mit dem Reis auf Boxen verteilen, offen abkühlen lassen und dann verschlossen in den Kühlschrank stellen."],"prepMinutes":15,"cookMinutes":35,"mealTypes":["lunch","dinner"],"storage":{"kind":"prep","fridgeDays":4,"freezable":true},"tags":["one-pot","high-protein"],"source":"starter","version":1,"sources":[]},{"id":"ei-gemuese-muffins","title":"Ei-Gemüse-Muffins mit Vollkornbrot","description":"Herzhafte Muffins aus Ei, Quark, Paprika und Spinat – drei Stück plus eine Scheibe Brot sind ein Frühstück.","servings":4,"ingredients":[{"ingredientId":"eier","amount":8,"unit":"stk"},{"ingredientId":"magerquark","amount":250,"unit":"g"},{"ingredientId":"gouda-gerieben","amount":80,"unit":"g"},{"ingredientId":"paprika-rot","amount":1,"unit":"stk"},{"ingredientId":"babyspinat","amount":100,"unit":"g"},{"ingredientId":"fruehlingszwiebel","amount":3,"unit":"stk"},{"ingredientId":"rapsoel","amount":1,"unit":"tl"},{"ingredientId":"vollkornbrot","amount":4,"unit":"stk"}],"steps":["Backofen auf 180 °C Umluft vorheizen und ein 12er-Muffinblech mit Öl auspinseln.","Paprika fein würfeln, Frühlingszwiebeln in Ringe schneiden, Spinat grob hacken.","Eier mit Quark glatt verquirlen, mit Salz und Pfeffer würzen, Gemüse und Käse unterheben.","Masse auf die 12 Mulden verteilen und 20–25 Minuten backen, bis sie gestockt sind.","Abkühlen lassen und je 3 Muffins mit einer Scheibe Vollkornbrot in eine Box packen."],"prepMinutes":15,"cookMinutes":25,"mealTypes":["breakfast"],"storage":{"kind":"prep","fridgeDays":3,"freezable":true},"tags":["ofen","high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/herzhafte-gemusemuffins","https://www.kitchenstories.com/de/rezepte/fruhstucksmuffins-4280"]},{"id":"fruehstuecks-burrito","title":"Frühstücks-Burrito mit Ei und Bohnen","description":"Rührei mit Kidneybohnen und Käse im Wrap – einzeln eingewickelt ideal zum Vorbereiten und Einfrieren.","servings":4,"ingredients":[{"ingredientId":"kidneybohnen","amount":255,"unit":"g","note":"abgetropft"},{"ingredientId":"fruehlingszwiebel","amount":5,"unit":"stk"},{"ingredientId":"eier","amount":6,"unit":"stk"},{"ingredientId":"gouda-gerieben","amount":100,"unit":"g"},{"ingredientId":"weizen-wraps","amount":4,"unit":"stk"},{"ingredientId":"saure-sahne","amount":100,"unit":"g"},{"ingredientId":"olivenoel","amount":1,"unit":"el"}],"steps":["Frühlingszwiebeln in Ringe schneiden, Bohnen abspülen und abtropfen lassen.","Öl in einer großen Pfanne erhitzen, Frühlingszwiebeln 2 Minuten anbraten, Bohnen zugeben.","Eier verquirlen, mit Salz, Pfeffer und etwas Cayennepfeffer würzen, in die Pfanne geben und langsam stocken lassen. Käse unterrühren.","Wraps kurz erwärmen, mit saurer Sahne bestreichen, Füllung darauf verteilen und fest aufrollen.","Zum Vorkochen einzeln in Backpapier oder Folie wickeln; zum Essen in der Pfanne oder Mikrowelle erwärmen."],"prepMinutes":10,"cookMinutes":15,"mealTypes":["breakfast","lunch"],"storage":{"kind":"prep","fridgeDays":3,"freezable":true},"tags":["high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/fruehstuecks-burrito"]},{"id":"huettenkaese-brot-tomate","title":"Hüttenkäse-Brot mit Tomate","description":"Vollkornbrot mit körnigem Frischkäse, Tomatenscheiben und einem Schuss Olivenöl.","servings":1,"ingredients":[{"ingredientId":"vollkornbrot","amount":2,"unit":"stk"},{"ingredientId":"koerniger-frischkaese","amount":200,"unit":"g"},{"ingredientId":"tomaten","amount":1,"unit":"stk"},{"ingredientId":"olivenoel","amount":1,"unit":"tl"}],"steps":["Tomate in Scheiben schneiden.","Brot dick mit körnigem Frischkäse bestreichen und mit Tomatenscheiben belegen.","Mit Olivenöl beträufeln, salzen, pfeffern und nach Wunsch mit Basilikum bestreuen."],"prepMinutes":5,"cookMinutes":0,"mealTypes":["breakfast","snack"],"storage":{"kind":"fresh"},"tags":["schnell","high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/zutaten/huettenkaese-rezepte"]},{"id":"joghurt-apfel-nuesse","title":"Joghurt mit Apfel, Walnüssen und Haferflocken","description":"Schnelle Frühstücksschale mit Naturjoghurt, frischem Apfel und gerösteten Nüssen.","servings":1,"ingredients":[{"ingredientId":"naturjoghurt","amount":200,"unit":"g"},{"ingredientId":"haferflocken","amount":40,"unit":"g"},{"ingredientId":"apfel","amount":1,"unit":"stk"},{"ingredientId":"walnuesse","amount":15,"unit":"g"},{"ingredientId":"honig","amount":10,"unit":"g"}],"steps":["Apfel entkernen und klein würfeln.","Walnüsse grob hacken und in einer Pfanne ohne Fett kurz rösten.","Joghurt in eine Schale geben, Haferflocken, Apfel und Nüsse darauf verteilen und mit Honig beträufeln."],"prepMinutes":5,"cookMinutes":0,"mealTypes":["breakfast","snack"],"storage":{"kind":"fresh"},"tags":["schnell","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/joghurt-mit-haferflocken-und-apfel"]},{"id":"omelett-spinat-feta","title":"Omelett mit Spinat und Feta","description":"Luftiges Omelett, gefüllt mit frischem Spinat und würzigem Hirtenkäse.","servings":2,"ingredients":[{"ingredientId":"eier","amount":5,"unit":"stk"},{"ingredientId":"milch-fettarm","amount":3,"unit":"el"},{"ingredientId":"babyspinat","amount":150,"unit":"g"},{"ingredientId":"hirtenkaese","amount":100,"unit":"g"},{"ingredientId":"butter","amount":10,"unit":"g"}],"steps":["Eier mit Milch, Salz, Pfeffer und etwas geriebener Muskatnuss verquirlen.","Die Hälfte der Butter in einer Pfanne schmelzen, die Hälfte der Eimasse hineingeben und bei mittlerer Hitze 1–2 Minuten stocken lassen.","Die Hälfte des Spinats und des zerbröselten Käses auf eine Hälfte geben, Omelett zuklappen und noch 2 Minuten garen.","Mit der zweiten Portion genauso verfahren."],"prepMinutes":5,"cookMinutes":10,"mealTypes":["breakfast","dinner"],"storage":{"kind":"fresh"},"tags":["schnell","high-protein","low-carb","vegetarisch"],"source":"starter","version":1,"sources":["https://www.kitchenstories.com/omelett-mit-spinat-und-feta/204506","https://www.essen-und-trinken.de/rezepte/84457-rzpt-spinat-omelette-mit-feta"]},{"id":"overnight-oats","title":"Overnight Oats mit Quark","description":"Proteinreiches Frühstück, abends in 5 Minuten vorbereitet.","servings":1,"ingredients":[{"ingredientId":"haferflocken","amount":50,"unit":"g"},{"ingredientId":"magerquark","amount":150,"unit":"g"},{"ingredientId":"milch-fettarm","amount":100,"unit":"ml"}],"steps":["Haferflocken, Quark und Milch in einem Glas mit Deckel glatt verrühren.","Verschlossen über Nacht in den Kühlschrank stellen.","Morgens nach Wunsch mit Obst toppen."],"prepMinutes":5,"cookMinutes":0,"mealTypes":["breakfast","snack"],"storage":{"kind":"prep","fridgeDays":2,"freezable":false},"tags":["ohne-kochen","high-protein"],"source":"starter","version":1,"sources":[]},{"id":"overnight-oats-apfel-zimt","title":"Overnight Oats Apfel-Zimt","description":"Cremige Haferflocken mit Skyr, Apfelstückchen und Walnüssen – abends vorbereitet, morgens fertig.","servings":1,"ingredients":[{"ingredientId":"haferflocken","amount":50,"unit":"g"},{"ingredientId":"skyr","amount":150,"unit":"g"},{"ingredientId":"milch-fettarm","amount":100,"unit":"ml"},{"ingredientId":"apfel","amount":0.5,"unit":"stk"},{"ingredientId":"chiasamen","amount":5,"unit":"g"},{"ingredientId":"walnuesse","amount":10,"unit":"g"}],"steps":["Haferflocken, Chiasamen, Skyr und Milch in einem Schraubglas verrühren und kräftig mit Zimt würzen.","Den Apfel entkernen, klein würfeln und die Hälfte unterheben.","Glas verschließen und über Nacht in den Kühlschrank stellen.","Vor dem Essen mit den restlichen Apfelwürfeln und grob gehackten Walnüssen bestreuen."],"prepMinutes":5,"cookMinutes":0,"mealTypes":["breakfast"],"storage":{"kind":"prep","fridgeDays":2,"freezable":false},"tags":["ohne-kochen","high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://www.kitchenstories.com/de/rezepte/apfel-zimt-overnightoats-f8db","https://eatsmarter.de/rezepte/overnight-oats-mit-aepfeln"]},{"id":"porridge-banane-erdnussmus","title":"Porridge mit Banane und Erdnussmus","description":"Warmer Haferbrei, gesüßt mit reifer Banane und abgerundet mit einem Löffel Erdnussmus.","servings":1,"ingredients":[{"ingredientId":"haferflocken","amount":60,"unit":"g"},{"ingredientId":"milch-fettarm","amount":250,"unit":"ml"},{"ingredientId":"banane","amount":1,"unit":"stk"},{"ingredientId":"erdnussmus","amount":15,"unit":"g"}],"steps":["Die Hälfte der Banane mit einer Gabel zerdrücken.","Milch mit der zerdrückten Banane und einer Prise Zimt aufkochen, Haferflocken einrühren.","Bei kleiner Hitze unter Rühren 3–5 Minuten köcheln, bis ein cremiger Brei entsteht.","In eine Schüssel füllen, mit den restlichen Bananenscheiben und dem Erdnussmus toppen."],"prepMinutes":2,"cookMinutes":8,"mealTypes":["breakfast"],"storage":{"kind":"fresh"},"tags":["schnell","vegetarisch"],"source":"starter","version":1,"sources":["https://www.kitchenstories.com/de/rezepte/bananen-porridge-mit-fruchten-a6ea","https://eatsmarter.de/rezepte/overnight-oats-mit-banane-und-erdnussmus"]},{"id":"protein-pancakes","title":"Protein-Pancakes mit Quark und Heidelbeeren","description":"Fluffige Pancakes aus Haferflocken, Magerquark und Ei – lassen sich gut vorbacken und einfrieren.","servings":2,"ingredients":[{"ingredientId":"haferflocken","amount":80,"unit":"g"},{"ingredientId":"magerquark","amount":250,"unit":"g"},{"ingredientId":"eier","amount":2,"unit":"stk"},{"ingredientId":"milch-fettarm","amount":50,"unit":"ml"},{"ingredientId":"backpulver","amount":5,"unit":"g"},{"ingredientId":"rapsoel","amount":1,"unit":"el"},{"ingredientId":"heidelbeeren-tk","amount":100,"unit":"g"}],"steps":["Haferflocken im Mixer fein mahlen.","Quark, Eier, Milch, Backpulver und eine Prise Zimt dazugeben und zu einem dicken Teig mixen. 5 Minuten quellen lassen.","Etwas Öl in einer beschichteten Pfanne erhitzen und pro Pancake 2 Esslöffel Teig hineingeben.","Bei mittlerer Hitze von jeder Seite etwa 2 Minuten goldbraun backen.","Mit aufgetauten Heidelbeeren servieren. Zum Vorkochen abkühlen lassen und mit Backpapier dazwischen in eine Box legen."],"prepMinutes":10,"cookMinutes":15,"mealTypes":["breakfast"],"storage":{"kind":"prep","fridgeDays":3,"freezable":true},"tags":["high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/protein-pancakes-mit-magerquark","https://www.kitchenstories.com/quark-haferflocken-pancakes/145969"]},{"id":"quarkbrot-radieschen","title":"Quarkbrot mit Radieschen und Schnittlauch","description":"Vollkornbrot mit cremigem Magerquark, knackigen Radieschen und frischem Schnittlauch.","servings":1,"ingredients":[{"ingredientId":"vollkornbrot","amount":2,"unit":"stk"},{"ingredientId":"magerquark","amount":150,"unit":"g"},{"ingredientId":"radieschen","amount":6,"unit":"stk"},{"ingredientId":"schnittlauch","amount":5,"unit":"g"}],"steps":["Quark mit 1–2 Esslöffeln Wasser glatt rühren, mit Salz und Pfeffer würzen.","Radieschen in dünne Scheiben, Schnittlauch in Röllchen schneiden.","Brot mit Quark bestreichen, mit Radieschen belegen und mit Schnittlauch bestreuen."],"prepMinutes":5,"cookMinutes":0,"mealTypes":["breakfast","snack"],"storage":{"kind":"fresh"},"tags":["schnell","high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://www.essen-und-trinken.de/rezepte/48116-rzpt-kraeuter-radieschen-quark"]},{"id":"ruehrei-vollkornbrot","title":"Rührei auf Vollkornbrot","description":"Klassisches Rührei mit Schnittlauch auf kräftigem Vollkornbrot, dazu Tomate.","servings":1,"ingredients":[{"ingredientId":"eier","amount":3,"unit":"stk"},{"ingredientId":"milch-fettarm","amount":30,"unit":"ml"},{"ingredientId":"butter","amount":5,"unit":"g"},{"ingredientId":"vollkornbrot","amount":2,"unit":"stk"},{"ingredientId":"schnittlauch","amount":5,"unit":"g"},{"ingredientId":"tomaten","amount":1,"unit":"stk"}],"steps":["Eier mit Milch, Salz und Pfeffer verquirlen, Schnittlauch in Röllchen schneiden.","Butter in einer beschichteten Pfanne bei mittlerer Hitze schmelzen, Eier hineingeben und unter langsamem Schieben cremig stocken lassen.","Rührei auf das Brot geben, mit Schnittlauch bestreuen und mit Tomatenscheiben servieren."],"prepMinutes":5,"cookMinutes":5,"mealTypes":["breakfast"],"storage":{"kind":"fresh"},"tags":["schnell","high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://www.lecker.de/ruehrei-auf-vollkornbrot-72211.html"]},{"id":"skyr-bowl-beeren","title":"Skyr-Bowl mit Beeren und Haferflocken","description":"Eiweißreiche Frühstücksschale aus Skyr, Erdbeeren, Haferflocken und Mandeln.","servings":1,"ingredients":[{"ingredientId":"skyr","amount":250,"unit":"g"},{"ingredientId":"haferflocken","amount":40,"unit":"g"},{"ingredientId":"erdbeeren-tk","amount":100,"unit":"g"},{"ingredientId":"honig","amount":10,"unit":"g"},{"ingredientId":"mandeln","amount":10,"unit":"g"}],"steps":["Erdbeeren am Vorabend im Kühlschrank auftauen lassen oder kurz in der Mikrowelle antauen.","Skyr mit Honig glatt rühren und in eine Schale geben.","Mit Erdbeeren, Haferflocken und grob gehackten Mandeln belegen."],"prepMinutes":5,"cookMinutes":0,"mealTypes":["breakfast","snack"],"storage":{"kind":"fresh"},"tags":["schnell","high-protein","vegetarisch"],"source":"starter","version":1,"sources":["https://eatsmarter.de/rezepte/skyr-bowl","https://eatsmarter.de/rezepte/skyr-mit-erdbeeren-und-haferflocken"]}]}
